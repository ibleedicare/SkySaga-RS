# Copy to `.env` to configure `docker compose up`. Every line is optional; the defaults are
# what the compose file uses when the file is absent.

# Where Entities.json and geodata.json live on the host, mounted read-only at /data.
#SKYSAGA_DATA_DIR=./data

# The address handed to the client. 127.0.0.1 is right when the client runs on this host;
# set the host's LAN address to play from another machine.
#SKYSAGA_PUBLIC_IP=127.0.0.1

# `user:pass,other:pass` to restrict logins. Unset accepts any non-empty account name.
#SKYSAGA_ACCOUNTS=

#RUST_LOG=info

# Host-side ports. The container always listens on the defaults; these only move the
# published side, and the client has to be told about anything but the defaults.
#SKYSAGA_WEB_PORT=5164
#SKYSAGA_AUTH_PORT=10106
#SKYSAGA_CHAT_PORT=4444
#SKYSAGA_GAME_PORT=42069
