# Unanchored, so it matches at any depth: an anchored `/target` missed
# `launcher/target`, and 8.4 GB of build output was committed before anyone noticed.
target/

# C# build output from the golden-vector generator
bin/
obj/

# the default SQLite database
skysaga.db
skysaga.db-shm
skysaga.db-wal

# the launcher is its own workspace
/launcher/target
# a rustup toolchain, if one was ever installed here by mistake
/launcher/.rustup
